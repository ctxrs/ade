    "supabase:migrations:check": "node -e 'const fs=require(\"fs\"); const path=require(\"path\"); const dir=path.join(process.cwd(),\"..\",\"supabase\",\"migrations\"); if(!fs.existsSync(dir)) { console.error(\"error: missing supabase/migrations\"); process.exit(1); } const files=fs.readdirSync(dir).filter((f)=>f.endsWith(\".sql\")).sort(); if(files.length===0) { console.error(\"error: no supabase migrations found\"); process.exit(1); } const seen=new Set(); for(const f of files){ if(seen.has(f)) { console.error(\"error: duplicate migration \"+f); process.exit(1);} seen.add(f); if(!/^\\d{14}_.+\\.sql$/.test(f)) { console.error(\"error: bad migration filename \"+f+\" (expected YYYYMMDDHHMMSS_name.sql)\"); process.exit(1);} } console.log(\"supabase migrations ok (\"+files.length+\")\");'",
    "supabase:functions:check": "bash -lc 'if ! command -v deno >/dev/null 2>&1; then echo \"supabase functions: skipped (deno not installed)\"; exit 0; fi; deno check --quiet --config ../supabase/deno.json ../supabase/functions/*/index.ts'",
