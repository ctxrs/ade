load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "sources",
    srcs = glob(["**"]),
)

COMMON_CORE_DATA = [
    "//core:package.json",
    "//core:pnpm-lock.yaml",
    "//core:pnpm-workspace.yaml",
    "//core/scripts:sources",
]

BUILDKITE_CONTRACT_DATA = COMMON_CORE_DATA + [
    "//:buildkite_pipeline_sources",
    "//:buildkite_script_sources",
    "//:ci_script_sources",
    "//:ctx_doc_sources",
]

DESKTOP_RELEASE_CONTRACT_DATA = COMMON_CORE_DATA + [
    "//core:desktop_bundle_files",
    "//core:desktop_release_metadata_files",
    "//core:provider_matrix_sources",
]

PROVIDER_AUTH_CONTRACT_DATA = COMMON_CORE_DATA + [
    "//core:desktop_automation_files",
    "//core:provider_matrix_sources",
]

DESKTOP_PARITY_CONTRACT_DATA = COMMON_CORE_DATA + [
    "//:repo_script_sources",
    "//core:desktop_automation_files",
    "//core:desktop_bundle_files",
    "//core:desktop_release_metadata_files",
    "//core:provider_matrix_sources",
]


sh_binary(
    name = "provider_auth_validate",
    srcs = ["//tools/bazel:run_workspace_task.sh"],
    args = ["core", "pnpm", "provider-auth:validate"],
    data = PROVIDER_AUTH_CONTRACT_DATA,
)

sh_binary(
    name = "desktop_version_check",
    srcs = ["//tools/bazel:run_workspace_task.sh"],
    args = ["core", "pnpm", "desktop:check:versions"],
    data = DESKTOP_RELEASE_CONTRACT_DATA,
)

sh_binary(
    name = "desktop_runtime_lock_check_matrix",
    srcs = ["//tools/bazel:run_workspace_task.sh"],
    args = ["core", "pnpm", "desktop:runtime:lock:check-matrix"],
    data = DESKTOP_RELEASE_CONTRACT_DATA,
)

sh_binary(
    name = "desktop_runtime_lock_validate",
    srcs = ["//tools/bazel:run_workspace_task.sh"],
    args = ["core", "node", "scripts/runtime_lock_validate.cjs", "--profile", "parity"],
    data = DESKTOP_RELEASE_CONTRACT_DATA,
)

sh_binary(
    name = "desktop_provider_matrix_archive_contracts",
    srcs = ["//tools/bazel:run_workspace_task.sh"],
    args = ["core", "node", "--test", "scripts/provider_matrix_archive_gap_report.test.cjs", "scripts/provider_matrix_required_targets_gate.test.cjs"],
    data = DESKTOP_PARITY_CONTRACT_DATA,
)

sh_binary(
    name = "desktop_launch_mode_contracts",
    srcs = ["//tools/bazel:run_workspace_task.sh"],
    args = ["core", "node", "--test", "scripts/desktop_mode_contract.test.cjs", "scripts/desktop_prepare.test.cjs", "scripts/desktop_tauri_entry.test.cjs"],
    data = DESKTOP_PARITY_CONTRACT_DATA,
)

sh_binary(
    name = "desktop_bundle_contracts",
    srcs = ["//tools/bazel:run_workspace_task.sh"],
    args = ["core", "node", "--test", "scripts/desktop_import_bundles.test.cjs", "scripts/desktop_normalize_bundle_permissions.test.cjs", "scripts/desktop_icon_reps.test.cjs"],
    data = DESKTOP_PARITY_CONTRACT_DATA,
)

sh_binary(
    name = "bundled_harness_dependency_contracts",
    srcs = ["//tools/bazel:run_workspace_task.sh"],
    args = [".", "bash", "-lc", "scripts/tests/providers_e2e_darwin_codex_fallback_guard.sh && scripts/tests/ensure_bundled_harnesses_droid_dependencies.sh"],
    data = DESKTOP_PARITY_CONTRACT_DATA,
)

sh_binary(
    name = "desktop_e2e_preflight_contracts",
    srcs = ["//tools/bazel:run_workspace_task.sh"],
    args = ["core", "node", "--test", "scripts/desktop_e2e_preflight.test.cjs"],
    data = DESKTOP_PARITY_CONTRACT_DATA,
)

sh_binary(
    name = "desktop_sync_resources_contracts",
    srcs = ["//tools/bazel:run_workspace_task.sh"],
    args = ["core", "node", "--test", "scripts/desktop_sync_resources_remote_daemon_policy.test.cjs", "scripts/desktop_sync_resources_avf_guest_runtime.test.cjs", "scripts/desktop_daemon_sidecar_name.test.cjs", "apps/desktop/automation/wdio.container-assets.test.cjs"],
    data = DESKTOP_PARITY_CONTRACT_DATA,
)

sh_binary(
    name = "providers_e2e_bundle_contracts",
    srcs = ["//tools/bazel:run_workspace_task.sh"],
    args = ["core", "node", "--test", "scripts/providers_e2e_bundle_isolation.test.cjs"],
    data = DESKTOP_PARITY_CONTRACT_DATA,
)

sh_binary(
    name = "linux_arm_provider_contracts",
    srcs = ["//tools/bazel:run_workspace_task.sh"],
    args = ["core", "node", "--test", "scripts/linux_arm_provider_reliability_matrix.test.cjs", "scripts/linux_arm_provider_preflight.test.cjs", "scripts/linux_arm_provider_report_summary.test.cjs", "scripts/linux_arm_provider_release_gate.test.cjs"],
    data = DESKTOP_PARITY_CONTRACT_DATA,
)


sh_binary(
    name = "tauri_tools_lock_contracts",
    srcs = ["//tools/bazel:run_workspace_task.sh"],
    args = ["core", "node", "--test", "scripts/tauri_tools_lock_contract.test.cjs"],
    data = DESKTOP_PARITY_CONTRACT_DATA,
)

sh_binary(
    name = "install_desktop_deps_contracts",
    srcs = ["//tools/bazel:run_workspace_task.sh"],
    args = [".", "bash", "scripts/tests/install_desktop_deps_linux_ubuntu_contract.sh"],
    data = DESKTOP_PARITY_CONTRACT_DATA,
)

sh_binary(
    name = "rust_bazel_deps_contracts",
    srcs = ["rust_bazel_deps_contract.sh"],
)
