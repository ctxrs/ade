{
  "name": "ctx-desktop",
  "private": true,
  "version": "0.65.11",
  "scripts": {
    "dev": "node ../../scripts/desktop_tauri_entry.cjs dev",
    "build": "node ../../scripts/desktop_tauri_entry.cjs build",
    "test:notifications:contracts": "bash scripts/test_notification_contracts.sh",
    "test:renderer-capabilities:contracts": "bash scripts/test_renderer_capabilities_contracts.sh",
    "test:automation": "wdio run automation/wdio.conf.cjs",
    "test:automation:notifications-signed-smoke": "CTX_AUTOMATION_SCENARIOS=${CTX_AUTOMATION_SCENARIOS:-notification-signed-smoke} wdio run automation/wdio.conf.cjs --spec automation/specs/notification-signed-smoke.spec.cjs",
    "test:automation:image-paste": "../../../scripts/desktop_smoke_with_infisical.sh -- --spec automation/specs/workbench-image-paste.spec.cjs",
    "test:automation:image-drag-drop": "../../../scripts/desktop_smoke_with_infisical.sh -- --spec automation/specs/workbench-image-drag-drop.spec.cjs",
    "test:automation:provider-auth-matrix": "../../../scripts/desktop_smoke_with_infisical.sh -- --spec automation/specs/provider-auth-matrix-cell.spec.cjs",
    "test:automation:break-matrix": "../../../scripts/desktop_smoke_with_infisical.sh -- --spec automation/specs/container-daemon-liveness.spec.cjs --spec automation/specs/container-provider-openrouter.spec.cjs --spec automation/specs/harness-install-probe-matrix.spec.cjs --spec automation/specs/remote-container-contract.spec.cjs",
    "test:automation:first-run-local-sandbox": "CTX_AUTOMATION_CN_SHARED_BACKEND=${CTX_AUTOMATION_CN_SHARED_BACKEND:-0} CTX_AUTOMATION_SCENARIOS=${CTX_AUTOMATION_SCENARIOS:-local-avf-first-run} wdio run automation/wdio.conf.cjs --spec automation/specs/workspace-wizard.spec.cjs",
    "test:automation:webview-recovery": "wdio run automation/wdio.conf.cjs --spec automation/specs/webview-recovery.spec.cjs",
    "test:automation:updater-native-smoke": "CTX_AUTOMATION_SCENARIOS=${CTX_AUTOMATION_SCENARIOS:-updater-native-smoke} CTX_AUTOMATION_SKIP_DESKTOP_PREP_RELEASE=${CTX_AUTOMATION_SKIP_DESKTOP_PREP_RELEASE:-1} ../../../scripts/desktop_smoke_with_infisical.sh -- --spec automation/specs/updater-native-smoke.spec.cjs",
    "test:automation:remote-bootstrap": "CTX_AUTOMATION_SCENARIOS=${CTX_AUTOMATION_SCENARIOS:-remote-bootstrap} wdio run automation/wdio.conf.cjs --spec automation/specs/remote-bootstrap-install.spec.cjs",
    "test:automation:remote-container-contract": "CTX_AUTOMATION_SCENARIOS=${CTX_AUTOMATION_SCENARIOS:-remote-new-disk-isolated} wdio run automation/wdio.conf.cjs --spec automation/specs/remote-container-contract.spec.cjs",
    "test:automation:remote-contracts": "scripts/test_remote_real_ci.sh",
    "test:automation:remote-contracts:docker": "bash scripts/test_remote_docker_contracts.sh",
    "test:automation:remote-bootstrap:matrix": "scripts/test_remote_bootstrap_auth_matrix.sh",
    "test:automation:updater-mismatch": "wdio run automation/wdio.conf.cjs --spec automation/specs/updater-mismatch-confirmation.spec.cjs",
    "test:automation:updater-remote": "CTX_AUTOMATION_SCENARIOS=${CTX_AUTOMATION_SCENARIOS:-updater-remote} CTX_AUTOMATION_SKIP_DESKTOP_PREP_RELEASE=${CTX_AUTOMATION_SKIP_DESKTOP_PREP_RELEASE:-1} ../../../scripts/desktop_smoke_with_infisical.sh -- --spec automation/specs/updater-remote-daemon-e2e.spec.cjs"
  },
  "devDependencies": {
    "@crabnebula/tauri-driver": "2.0.8",
    "@crabnebula/test-runner-backend": "0.1.18",
    "@tauri-apps/cli": "^2.9.6",
    "@wdio/cli": "^9.8.1",
    "@wdio/local-runner": "^9.8.1",
    "@wdio/mocha-framework": "^9.8.1",
    "@wdio/runner": "^9.8.1",
    "@wdio/spec-reporter": "^9.8.1",
    "webdriverio": "^9.8.1"
  }
}
