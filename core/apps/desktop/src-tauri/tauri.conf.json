{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "ctx",
  "version": "0.1.0",
  "identifier": "rs.context.desktop",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devUrl": "http://localhost:5173",
    "frontendDist": "web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["context"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["bin/*", "web/dist/**/*"],
    "externalBin": ["bin/context", "bin/context-mcp"],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
