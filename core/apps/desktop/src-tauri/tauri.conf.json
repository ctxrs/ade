{
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "../stub",
    "distDir": "../stub"
  },
  "package": {
    "productName": "Context",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": false
      }
    },
    "bundle": {
      "active": true,
      "identifier": "rs.context.desktop",
      "resources": ["bin/*", "web/dist/**"],
      "externalBin": ["bin/context", "bin/context-mcp"],
      "targets": "all"
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Context",
        "width": 1200,
        "height": 780
      }
    ]
  }
}
