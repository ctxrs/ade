{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ctx",
  "version": "0.1.0",
  "identifier": "rs.ctx.tauri.mobile",
  "build": {
    "frontendDist": "../../web/dist",
    "beforeDevCommand": "pnpm -C ../../web dev",
    "beforeBuildCommand": "pnpm -C ../../web build"
  },
  "app": {
    "windows": [
      {
        "title": "ctx",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
