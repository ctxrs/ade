{
  "name": "ctx-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "HOST=$(tailscale ip -4 2>/dev/null | head -n 1); if [ -z \"$HOST\" ]; then HOST=127.0.0.1; fi; vite --host \"$HOST\"",
    "build": "vite build",
    "preview": "vite preview",
    "preview:public": "HOST=$(tailscale ip -4 2>/dev/null | head -n 1); if [ -z \"$HOST\" ]; then HOST=127.0.0.1; fi; vite preview --host \"$HOST\" --port 5173",
    "build:preview:public": "pnpm build && pnpm preview:public",
    "loadtest:replay": "node ./scripts/replay-loadtest.mjs",
    "wal:attach": "node ./scripts/wal-attach.mjs",
    "any:report": "node ./scripts/explicit-any-report.mjs --format table",
    "any:baseline": "node ./scripts/explicit-any-report.mjs --write-baseline --format table",
    "any:enforce": "node ./scripts/explicit-any-report.mjs --enforce --enforce-mode zero --format table",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:quiet": "vitest run --silent --reporter=dot",
    "test:watch": "vitest",
    "test:e2e": "node ./scripts/run-e2e-suite.mjs all",
    "test:e2e:list": "node ./scripts/run-e2e-suite.mjs all --list",
    "test:e2e:premerge": "node ./scripts/run-e2e-suite.mjs premerge_required",
    "test:e2e:release": "node ./scripts/run-e2e-suite.mjs release_required",
    "test:e2e:cross-platform": "node ./scripts/run-e2e-suite.mjs cross_platform",
    "test:e2e:visual": "node ./scripts/run-e2e-suite.mjs visual",
    "test:e2e:soak": "node ./scripts/run-e2e-suite.mjs soak",
    "test:e2e:load": "node ./scripts/run-e2e-suite.mjs load",
    "test:e2e:updater:smoke": "pnpm exec playwright test -c playwright.premerge.config.ts e2e/daemon-availability-update-banner.spec.ts e2e/updater-workbench-auto-apply.spec.ts e2e/updater-diagnostics-failure-safety.spec.ts e2e/updater-desktop-mismatch-confirmation.spec.ts",
    "test:e2e:updater:ui-contract": "pnpm exec playwright test -c playwright.premerge.config.ts e2e/updater-desktop-ui-contract.spec.ts e2e/updater-global-semantics.spec.ts",
    "test:e2e:flake-report": "node ./scripts/flake-report.mjs --format table",
    "test:e2e:quarantine-sync": "node ./scripts/quarantine-sync.mjs",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.4",
    "@pretext-virtualizer/core": "workspace:*",
    "@pretext-virtualizer/interface": "workspace:*",
    "@ctx/design": "workspace:*",
    "@ctx/types": "workspace:*",
    "@monaco-editor/react": "^4.6.0",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@supabase/supabase-js": "^2.49.1",
    "@tauri-apps/api": "^2.9.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-os": "2.3.2",
    "@tauri-apps/plugin-shell": "2.3.4",
    "@virtuoso.dev/message-list": "^1.15.2",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "chrome-tabs": "5.4.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.561.0",
    "mdast-util-to-markdown": "^2.1.2",
    "monaco-editor": "^0.52.2",
    "posthog-js": "^1.234.5",
    "qrcode.react": "^4.2.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.28.0",
    "react-syntax-highlighter": "^15.6.1",
    "react-virtuoso": "^4.10.7",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "tailwind-merge": "^3.4.1",
    "tauri-plugin-stt-api": "^0.1.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@argos-ci/playwright": "^6.4.2",
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/qrcode.react": "^1.0.5",
    "@types/react": "~19.1.0",
    "@types/react-dom": "~19.1.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^2.1.8",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "jsdom": "^25.0.1",
    "pixelmatch": "^7.1.0",
    "playwright": "^1.57.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^5.4.11",
    "vite-plugin-mkcert": "^1.17.9",
    "vitest": "^2.1.8"
  }
}
