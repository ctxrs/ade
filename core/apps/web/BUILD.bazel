        "scripts/**/*",
        "eslint/**/*",
        "e2e/**/*",
        "public/**/*",
        "*.json",
        "*.html",
        "*.ts",
        "*.tsx",
        "*.mjs",
        "*.cjs",
    ],
    allow_empty = True,
)

