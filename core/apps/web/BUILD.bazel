        "eslint/**/*",
        "e2e/utils/**/*",
        "public/**/*",
        "*.json",
        "*.html",
        "*.ts",
        "*.tsx",
        "*.mjs",
        "*.cjs",
    ],
    exclude = [
        "playwright*.ts",
    ],
    allow_empty = True,
)

