{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "Cargo.lock",
    "rust-toolchain.toml",
    "rustfmt.toml",
    "clippy.toml",
    ".cargo/config.toml"
  ],
  "tasks": {
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": [
        ".turbo/tsbuildinfo/**"
      ]
    },
    "test:quiet": {
      "dependsOn": [
        "typecheck",
        "^typecheck"
      ],
      "outputs": []
    },
    "rust:fmt": {
      "outputs": []
    },
    "rust:clippy": {
      "outputs": []
    },
    "rust:test": {
      "outputs": []
    },
    "native:check": {
      "outputs": []
    },
    "native:test": {
      "outputs": []
    },
    "native:test:automation": {
      "outputs": []
    }
  }
}
