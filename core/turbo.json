{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": [
        ".turbo/tsbuildinfo/**"
      ]
    },
    "test:quiet": {
      "dependsOn": [
        "typecheck",
        "^typecheck"
      ],
      "outputs": []
    },
    "rust:fmt": {
      "outputs": []
    },
    "rust:clippy": {
      "outputs": [
        ".turbo/cargo-target/**"
      ]
    },
    "rust:test": {
      "outputs": [
        ".turbo/cargo-target/**"
      ]
    }
  }
}
