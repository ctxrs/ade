{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "Cargo.lock",
    "rust-toolchain.toml",
    "rustfmt.toml",
    "clippy.toml",
    ".cargo/config.toml"
  ],
  "tasks": {
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": [
        ".turbo/tsbuildinfo/**"
      ]
    },
    "test:quiet": {
      "dependsOn": [
        "typecheck",
        "^typecheck"
      ],
      "outputs": []
    },
    "rust:fmt": {
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "crates/**"
      ],
      "outputs": []
    },
    "rust:clippy": {
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "crates/**"
      ],
      "outputs": []
    },
    "rust:test": {
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "crates/**"
      ],
      "outputs": []
    },
    "native:check": {
      "inputs": [
        "apps/native/**",
        "crates/**"
      ],
      "outputs": []
    },
    "native:check:automation": {
      "inputs": [
        "apps/native/**",
        "crates/**"
      ],
      "outputs": []
    },
    "native:test": {
      "inputs": [
        "apps/native/**",
        "crates/**"
      ],
      "outputs": []
    },
    "native:test:automation": {
      "inputs": [
        "apps/native/**",
        "crates/**"
      ],
      "outputs": []
    },
    "ios-native:build": {
      "inputs": [
        "apps/ios-native/**"
      ],
      "outputs": []
    },
    "supabase:migrations:check": {
      "inputs": [
        "../supabase/config.toml",
        "../supabase/migrations/**"
      ],
      "outputs": []
    },
    "supabase:functions:check": {
      "inputs": [
        "../supabase/functions/**"
      ],
      "outputs": []
    }
  }
}
