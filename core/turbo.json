{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "CARGO_HOME",
    "CARGO_TARGET_DIR",
    "CTX_VERIFY_CARGO_TARGET_DIR",
    "CTX_VOLATILE_ROOT",
    "CTX_VOLATILE_ROOT_MODE",
    "CTX_VOLATILE_TARGETS_DIR",
    "CTX_VOLATILE_ARTIFACTS_DIR",
    "CTX_VOLATILE_TMPDIR",
    "CTX_BUNDLE_CACHE_DIR",
    "PLAYWRIGHT_BROWSERS_PATH",
    "TURBO_API",
    "TURBO_TOKEN",
    "TURBO_TEAM",
    "TURBO_CACHE_MODE",
    "RUSTC_WRAPPER",
    "SCCACHE_DIR",
    "SCCACHE_BUCKET",
    "SCCACHE_ENDPOINT",
    "SCCACHE_REGION",
    "SCCACHE_S3_KEY_PREFIX",
    "SCCACHE_S3_USE_SSL",
    "SCCACHE_BASEDIRS",
    "SCCACHE_PATH",
    "SCCACHE_SERVER_UDS",
    "CTX_SCCACHE_R2_BUCKET",
    "CTX_SCCACHE_R2_ACCOUNT_ID",
    "CTX_SCCACHE_R2_ENDPOINT",
    "CTX_SCCACHE_R2_KEY_PREFIX",
    "CTX_SCCACHE_R2_REGION",
    "CTX_SCCACHE_R2_JURISDICTION",
    "CTX_SCCACHE_R2_ACCESS_KEY_ID",
    "CTX_SCCACHE_R2_SECRET_ACCESS_KEY",
    "CTX_SCCACHE_R2_SESSION_TOKEN",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_SESSION_TOKEN",
    "CARGO_INCREMENTAL",
    "RUSTFLAGS",
    "RUST_TEST_THREADS",
    "RUSTUP_HOME"
  ],
  "globalDependencies": [
    "Cargo.lock",
    "rust-toolchain.toml",
    "rustfmt.toml",
    "clippy.toml",
    ".cargo/config.toml"
  ],
  "tasks": {
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": [
        ".turbo/tsbuildinfo/**"
      ]
    },
    "any:enforce": {
      "dependsOn": [
        "typecheck"
      ],
      "inputs": [
        "src/**",
        "e2e/**",
        "scripts/explicit-any-report.mjs",
        "package.json"
      ],
      "outputs": []
    },
    "test:quiet": {
      "dependsOn": [
        "typecheck",
        "^typecheck"
      ],
      "outputs": []
    },
    "rust:fmt": {
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "crates/**"
      ],
      "outputs": []
    },
    "rust:panic-traps": {
      "dependsOn": [
        "rust:fmt"
      ],
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "crates/**",
        "apps/desktop/src-tauri/src/**",
        "apps/tauri-mobile/src-tauri/src/**",
        "scripts/check_rust_runtime_panic_traps.mjs"
      ],
      "outputs": []
    },
    "rust:clippy": {
      "dependsOn": [
        "rust:panic-traps"
      ],
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "crates/**"
      ],
      "outputs": []
    },
    "rust:test": {
      "dependsOn": [
        "rust:clippy"
      ],
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "crates/**"
      ],
      "outputs": []
    },
    "supabase:migrations:check": {
      "inputs": [
        "../supabase/config.toml",
        "../supabase/migrations/**"
      ],
      "outputs": []
    },
    "supabase:functions:check": {
      "inputs": [
        "../supabase/functions/**"
      ],
      "outputs": []
    },
    "crp:codex": {
      "env": [
        "CTX_CRP_TARGET_DIR",
        "CTX_CRP_PROFILE",
        "CTX_CRP_CARGO_BUILD_JOBS"
      ],
      "inputs": [
        "package.json",
        "Cargo.toml",
        "Cargo.lock",
        "../scripts/build_codex_crp.sh",
        "../scripts/lib/codex_crp_build_env.sh",
        "crates/codex-crp/**"
      ],
      "outputs": []
    },
    "crp:codex:test": {
      "dependsOn": [
        "crp:codex"
      ],
      "env": [
        "CTX_CRP_TARGET_DIR",
        "CTX_CRP_PROFILE",
        "CTX_CRP_CARGO_BUILD_JOBS"
      ],
      "inputs": [
        "package.json",
        "Cargo.toml",
        "Cargo.lock",
        "../scripts/test_codex_crp.sh",
        "../scripts/lib/codex_crp_build_env.sh",
        "crates/codex-crp/**"
      ],
      "outputs": []
    },
    "crp:claude": {
      "inputs": [
        "../external-harnesses/claude-crp/**",
        "!../external-harnesses/claude-crp/dist/**",
        "!../external-harnesses/claude-crp/node_modules/**"
      ],
      "outputs": [
        "../external-harnesses/claude-crp/dist/**"
      ]
    }
  }
}
