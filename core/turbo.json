{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "CARGO_HOME",
    "CARGO_TARGET_DIR",
    "CTX_VERIFY_CARGO_TARGET_DIR",
    "RUSTUP_HOME"
  ],
  "globalDependencies": [
    "Cargo.lock",
    "rust-toolchain.toml",
    "rustfmt.toml",
    "clippy.toml",
    ".cargo/config.toml"
  ],
  "tasks": {
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": [
        ".turbo/tsbuildinfo/**"
      ]
    },
    "any:enforce": {
      "dependsOn": [
        "typecheck"
      ],
      "inputs": [
        "src/**",
        "e2e/**",
        "scripts/explicit-any-report.mjs",
        "package.json"
      ],
      "outputs": []
    },
    "test:quiet": {
      "dependsOn": [
        "typecheck",
        "^typecheck"
      ],
      "outputs": []
    },
    "rust:fmt": {
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "crates/**"
      ],
      "outputs": []
    },
    "rust:panic-traps": {
      "dependsOn": [
        "rust:fmt"
      ],
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "crates/**",
        "apps/desktop/src-tauri/src/**",
        "apps/tauri-mobile/src-tauri/src/**",
        "scripts/check_rust_runtime_panic_traps.mjs"
      ],
      "outputs": []
    },
    "rust:clippy": {
      "dependsOn": [
        "rust:panic-traps"
      ],
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "crates/**"
      ],
      "outputs": []
    },
    "rust:test": {
      "dependsOn": [
        "rust:clippy"
      ],
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "crates/**"
      ],
      "outputs": []
    },
    "supabase:migrations:check": {
      "inputs": [
        "../supabase/config.toml",
        "../supabase/migrations/**"
      ],
      "outputs": []
    },
    "supabase:functions:check": {
      "inputs": [
        "../supabase/functions/**"
      ],
      "outputs": []
    },
    "crp:codex": {
      "env": [
        "CTX_CRP_TARGET_DIR",
        "CTX_CRP_PROFILE",
        "CTX_CRP_CARGO_BUILD_JOBS"
      ],
      "inputs": [
        "package.json",
        "Cargo.toml",
        "Cargo.lock",
        "../scripts/build_codex_crp.sh",
        "../scripts/lib/codex_crp_build_env.sh",
        "crates/codex-crp/**"
      ],
      "outputs": []
    },
    "crp:codex:test": {
      "dependsOn": [
        "crp:codex"
      ],
      "env": [
        "CTX_CRP_TARGET_DIR",
        "CTX_CRP_PROFILE",
        "CTX_CRP_CARGO_BUILD_JOBS"
      ],
      "inputs": [
        "package.json",
        "Cargo.toml",
        "Cargo.lock",
        "../scripts/test_codex_crp.sh",
        "../scripts/lib/codex_crp_build_env.sh",
        "crates/codex-crp/**"
      ],
      "outputs": []
    },
    "crp:claude": {
      "inputs": [
        "../external-harnesses/claude-crp/**",
        "!../external-harnesses/claude-crp/dist/**",
        "!../external-harnesses/claude-crp/node_modules/**"
      ],
      "outputs": [
        "../external-harnesses/claude-crp/dist/**"
      ]
    }
  }
}
