{
  "version": 1,
  "provider": "codex",
  "case": "error_auth_required_tool_failed",
  "description": "Synthetic error case: tool fails + prompt returns auth-required error.",
  "events": [
    {
      "type": "session_update",
      "msg": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "sess_codex_err_1",
          "update": {
            "sessionUpdate": "agent_message_chunk",
            "content": { "type": "text", "text": "Attempting..." }
          }
        }
      }
    },
    {
      "type": "session_update",
      "msg": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "sess_codex_err_1",
          "update": {
            "sessionUpdate": "tool_call",
            "toolCallId": "tool_codex_read",
            "name": "read_file",
            "input": { "path": "/missing" }
          }
        }
      }
    },
    {
      "type": "session_update",
      "msg": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "sess_codex_err_1",
          "update": {
            "sessionUpdate": "tool_call_update",
            "toolCallId": "tool_codex_read",
            "status": "failed",
            "output": { "error": "ENOENT" }
          }
        }
      }
    },
    {
      "type": "prompt_response",
      "msg": {
        "jsonrpc": "2.0",
        "id": 2,
        "error": { "code": 401, "message": "authentication required" }
      }
    }
  ]
}

