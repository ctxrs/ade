{
  "version": 1,
  "provider": "claude",
  "case": "success_tool_call_agent_message_blocks",
  "description": "Synthetic claude-like stream: agent_message blocks + tool completion + end_turn, with _meta usage.",
  "events": [
    {
      "type": "session_update",
      "msg": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "session_id": "sess_claude_1",
          "update": {
            "sessionUpdate": "agent_message",
            "content": [
              { "type": "text", "text": "One " },
              { "type": "text", "text": "two" }
            ],
            "_meta": {
              "usage": { "input_tokens": 1, "output_tokens": 2 },
              "context_window": { "limit": 8192 }
            }
          }
        }
      }
    },
    {
      "type": "session_update",
      "msg": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "session_id": "sess_claude_1",
          "update": {
            "sessionUpdate": "tool_call",
            "toolCallId": "tool_claude_apply_patch",
            "name": "apply_patch",
            "input": { "patch": "*** Begin Patch\\n*** End Patch\\n" }
          }
        }
      }
    },
    {
      "type": "session_update",
      "msg": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "session_id": "sess_claude_1",
          "update": {
            "sessionUpdate": "tool_call_update",
            "toolCallId": "tool_claude_apply_patch",
            "status": "completed",
            "output": { "applied": true }
          }
        }
      }
    },
    {
      "type": "prompt_response",
      "msg": {
        "jsonrpc": "2.0",
        "id": 10,
        "result": { "stopReason": "end_turn" }
      }
    }
  ]
}

