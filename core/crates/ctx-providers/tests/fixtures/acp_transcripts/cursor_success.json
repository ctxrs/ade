{
  "version": 1,
  "provider": "cursor",
  "case": "success_tool_call_with_context_window",
  "description": "Synthetic cursor-like stream including context_window on the update object.",
  "events": [
    {
      "type": "session_update",
      "msg": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "sess_cursor_1",
          "update": {
            "sessionUpdate": "agent_message_chunk",
            "content": { "type": "text", "text": "Hi" },
            "context_window": { "limit": 16384 }
          }
        }
      }
    },
    {
      "type": "session_update",
      "msg": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "sess_cursor_1",
          "update": {
            "sessionUpdate": "tool_call",
            "toolCallId": "tool_cursor_cat",
            "name": "shell",
            "input": { "cmd": "cat README.md" }
          }
        }
      }
    },
    {
      "type": "session_update",
      "msg": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "sess_cursor_1",
          "update": {
            "sessionUpdate": "tool_call_update",
            "toolCallId": "tool_cursor_cat",
            "status": "completed",
            "output": { "bytes": 123 }
          }
        }
      }
    },
    {
      "type": "prompt_response",
      "msg": {
        "jsonrpc": "2.0",
        "id": 30,
        "result": { "stopReason": "end_turn" }
      }
    }
  ]
}

