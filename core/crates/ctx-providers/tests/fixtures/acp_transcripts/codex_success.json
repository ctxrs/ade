{
  "version": 1,
  "provider": "codex",
  "case": "success_tool_call",
  "description": "Synthetic codex-like stream: assistant chunks + tool call completion + end_turn.",
  "events": [
    {
      "type": "session_update",
      "msg": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "sess_codex_1",
          "update": {
            "sessionUpdate": "agent_message_chunk",
            "content": { "type": "text", "text": "Hello " }
          }
        }
      }
    },
    {
      "type": "session_update",
      "msg": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "sess_codex_1",
          "update": {
            "sessionUpdate": "tool_call",
            "toolCallId": "tool_codex_ls",
            "name": "shell",
            "input": { "cmd": "ls -1" }
          }
        }
      }
    },
    {
      "type": "session_update",
      "msg": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "sess_codex_1",
          "update": {
            "sessionUpdate": "tool_call_update",
            "toolCallId": "tool_codex_ls",
            "status": "completed",
            "output": { "ok": true }
          }
        }
      }
    },
    {
      "type": "session_update",
      "msg": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "sess_codex_1",
          "update": {
            "sessionUpdate": "agent_message_chunk",
            "content": { "type": "text", "text": "world" }
          }
        }
      }
    },
    {
      "type": "prompt_response",
      "msg": {
        "jsonrpc": "2.0",
        "id": 1,
        "result": { "stopReason": "end_turn" }
      }
    }
  ]
}

