{
  "version": 1,
  "provider": "gemini",
  "case": "success_thoughts_plan_tool_call",
  "description": "Synthetic gemini-like stream including thought chunks and a plan update.",
  "events": [
    {
      "type": "session_update",
      "msg": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "sess_gemini_1",
          "update": {
            "sessionUpdate": "agent_thought_chunk",
            "content": { "type": "text", "text": "thinking..." }
          }
        }
      }
    },
    {
      "type": "session_update",
      "msg": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "sess_gemini_1",
          "update": {
            "sessionUpdate": "plan",
            "steps": ["a", "b"]
          }
        }
      }
    },
    {
      "type": "session_update",
      "msg": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "sess_gemini_1",
          "update": {
            "sessionUpdate": "agent_message_chunk",
            "content": { "type": "text", "text": "OK" }
          }
        }
      }
    },
    {
      "type": "session_update",
      "msg": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "sess_gemini_1",
          "update": {
            "sessionUpdate": "tool_call",
            "toolCallId": "tool_gemini_rg",
            "name": "shell",
            "input": { "cmd": "rg -n hello ." }
          }
        }
      }
    },
    {
      "type": "session_update",
      "msg": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "sess_gemini_1",
          "update": {
            "sessionUpdate": "tool_call_update",
            "toolCallId": "tool_gemini_rg",
            "status": "completed",
            "output": { "matches": 0 }
          }
        }
      }
    },
    {
      "type": "prompt_response",
      "msg": {
        "jsonrpc": "2.0",
        "id": 20,
        "result": { "stopReason": "end_turn" }
      }
    }
  ]
}

