{
  "version": 1,
  "provider": "gemini",
  "case": "error_auth_required_tool_failed",
  "description": "Synthetic error case: tool failed + prompt returns auth-required error.",
  "events": [
    {
      "type": "session_update",
      "msg": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "sess_gemini_err_1",
          "update": {
            "sessionUpdate": "tool_call",
            "toolCallId": "tool_gemini_ls",
            "name": "shell",
            "input": { "cmd": "ls /root" }
          }
        }
      }
    },
    {
      "type": "session_update",
      "msg": {
        "jsonrpc": "2.0",
        "method": "session/update",
        "params": {
          "sessionId": "sess_gemini_err_1",
          "update": {
            "sessionUpdate": "tool_call_update",
            "toolCallId": "tool_gemini_ls",
            "status": "failed",
            "output": { "error": "permission denied" }
          }
        }
      }
    },
    {
      "type": "prompt_response",
      "msg": {
        "jsonrpc": "2.0",
        "id": 21,
        "error": { "code": 401, "message": "Unauthorized" }
      }
    }
  ]
}

