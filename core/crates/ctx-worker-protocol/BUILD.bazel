load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "lib",
    crate_name = "ctx_worker_protocol",
    crate_root = "src/lib.rs",
    edition = "2021",
    srcs = glob(["src/**/*.rs"]),
    deps = [
        "@crates//:chrono",
        "@crates//:serde",
        "@crates//:uuid",
    ],
)

rust_test(
    name = "unit_tests",
    crate = ":lib",
)
