load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "lib",
    crate_name = "ctx_fs",
    crate_root = "src/lib.rs",
    edition = "2021",
    srcs = glob(["src/**/*.rs"]),
    deps = [
        "//core/crates/ctx-core:lib",
        "@crates//:anyhow",
        "@crates//:directories",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "unit_tests",
    crate = ":lib",
    deps = ["@crates//:tempfile"],
)

rust_test(
    name = "jj_worktrees",
    crate_root = "tests/jj_worktrees.rs",
    edition = "2021",
    srcs = ["tests/jj_worktrees.rs"],
    deps = [
        ":lib",
        "@crates//:tempfile",
        "@crates//:tokio",
    ],
)
