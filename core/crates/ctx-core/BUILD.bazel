load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "lib",
    crate_name = "ctx_core",
    crate_root = "src/lib.rs",
    edition = "2021",
    srcs = glob(["src/**/*.rs"]),
    deps = [
        "@crates//:chrono",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:uuid",
    ],
)

rust_test(
    name = "unit_tests",
    crate = ":lib",
)

rust_test(
    name = "workspace_payload_corpus",
    crate_root = "tests/workspace_payload_corpus.rs",
    edition = "2021",
    srcs = ["tests/workspace_payload_corpus.rs"],
    data = glob(["tests/corpus/workspace_payloads/**"]),
    rustc_env = {
        "CARGO_MANIFEST_DIR": "core/crates/ctx-core",
    },
    deps = [
        ":lib",
        "@crates//:serde",
        "@crates//:serde_json",
    ],
)
