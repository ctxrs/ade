load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

CTX_TUNNEL_STORE_DEPS = [
    "@crates//:chrono",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:sqlx",
    "@crates//:thiserror",
    "@crates//:tokio",
    "@crates//:url",
]

rust_library(
    name = "lib",
    crate_name = "ctx_tunnel_store",
    crate_root = "src/lib.rs",
    edition = "2021",
    srcs = glob(["src/**/*.rs"]),
    deps = CTX_TUNNEL_STORE_DEPS,
)

rust_binary(
    name = "ctx-tunnel-cleanup",
    crate_root = "src/bin/ctx-tunnel-cleanup.rs",
    edition = "2021",
    srcs = ["src/bin/ctx-tunnel-cleanup.rs"],
    deps = [
        ":lib",
        "@crates//:chrono",
        "@crates//:serde_json",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "unit_tests",
    crate = ":lib",
)
