load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "lib",
    crate_name = "ctx_lsp",
    crate_root = "src/lib.rs",
    edition = "2021",
    srcs = glob(["src/**/*.rs"], exclude = ["src/bin/**/*.rs"]),
    deps = [
        "//core/crates/ctx-core:lib",
        "@crates//:anyhow",
        "@crates//:lsp-types",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tokio",
        "@crates//:tracing",
        "@crates//:url",
    ],
)

rust_binary(
    name = "ctx-lsp-test-server",
    crate_root = "src/bin/ctx-lsp-test-server.rs",
    edition = "2021",
    srcs = ["src/bin/ctx-lsp-test-server.rs"],
    deps = [
        "@crates//:anyhow",
        "@crates//:lsp-types",
        "@crates//:serde_json",
    ],
)

rust_test(
    name = "lsp_manager_smoke",
    crate_root = "tests/lsp_manager_smoke.rs",
    edition = "2021",
    srcs = ["tests/lsp_manager_smoke.rs"],
    args = ["--test-threads=1"],
    data = [":ctx-lsp-test-server"],
    rustc_env = {
        "CARGO_BIN_EXE_ctx-lsp-test-server": "$(rootpath :ctx-lsp-test-server)",
    },
    deps = [
        ":lib",
        "@crates//:lsp-types",
        "@crates//:serde_json",
        "@crates//:tempfile",
        "@crates//:tokio",
    ],
)
