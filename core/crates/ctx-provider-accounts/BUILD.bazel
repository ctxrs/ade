load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["src/provider_matrix.json"])

rust_library(
    name = "lib",
    crate_name = "ctx_provider_accounts",
    crate_root = "src/lib.rs",
    compile_data = ["src/provider_matrix.json"],
    edition = "2021",
    srcs = glob(["src/**/*.rs"]),
    deps = [
        "@crates//:anyhow",
        "@crates//:chrono",
        "@crates//:directories",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:tokio",
        "@crates//:tracing",
        "@crates//:uuid",
    ],
)

rust_test(
    name = "unit_tests",
    crate = ":lib",
    deps = [
        "@crates//:tempfile",
    ],
)

sh_binary(
    name = "goose-provider-stage-archive",
    srcs = ["//tools/bazel:provider_managed_install_archive.sh"],
    args = [
        "goose",
    ],
    data = [
        "src/provider_matrix.json",
        "//core:package.json",
    ],
)

sh_binary(
    name = "openhands-provider-stage-archive",
    srcs = ["//tools/bazel:provider_managed_install_archive.sh"],
    args = [
        "openhands",
    ],
    data = [
        "src/provider_matrix.json",
        "//core:package.json",
    ],
)
