load("@aspect_rules_js//js:defs.bzl", "js_test")

package(default_visibility = ["//visibility:public"])

INSTALL_SITE_SOURCES = glob([
    "src/**",
    "package.json",
    "package-lock.json",
    "wrangler.toml",
])

js_test(
    name = "install_route_contract_tests",
    entry_point = "src/run-node-test-suite.mjs",
    args = ["src/index.test.mjs"],
    chdir = package_name(),
    data = INSTALL_SITE_SOURCES,
)

js_test(
    name = "install_script_contract_tests",
    entry_point = "src/run-node-test-suite.mjs",
    args = [
        "src/install-script.test.mjs",
        "src/uninstall-script.test.mjs",
    ],
    chdir = package_name(),
    data = INSTALL_SITE_SOURCES,
)

js_test(
    name = "install_bootstrap_contract_tests",
    entry_point = "src/run-node-test-suite.mjs",
    args = ["src/install-bootstrap-ci.test.mjs"],
    chdir = package_name(),
    data = INSTALL_SITE_SOURCES,
)

test_suite(
    name = "install_contract_tests",
    tests = [
        ":install_route_contract_tests",
        ":install_script_contract_tests",
        ":install_bootstrap_contract_tests",
    ],
)
