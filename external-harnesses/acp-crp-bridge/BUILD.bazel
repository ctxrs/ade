load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

ACP_CRP_BRIDGE_RUSTC_ENV = {
    "CARGO_MANIFEST_DIR": "external-harnesses/acp-crp-bridge",
    "CARGO_PKG_VERSION": "0.1.3",
}

ACP_CRP_BRIDGE_DEPS = [
    "@crates//:agent-client-protocol",
    "@crates//:anyhow",
    "@crates//:async-trait",
    "@crates//:base64",
    "@crates//:clap",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:shell-words",
    "@crates//:tokio",
    "@crates//:tokio-util",
    "@crates//:tracing",
    "@crates//:tracing-subscriber",
    "@crates//:uuid",
]

rust_library(
    name = "lib",
    crate_name = "acp_crp_bridge",
    crate_root = "src/lib.rs",
    edition = "2021",
    srcs = glob(["src/**/*.rs"]),
    rustc_env = ACP_CRP_BRIDGE_RUSTC_ENV,
    deps = ACP_CRP_BRIDGE_DEPS,
)

rust_binary(
    name = "acp-crp-bridge",
    crate_root = "src/main.rs",
    edition = "2021",
    srcs = ["src/main.rs"],
    rustc_env = ACP_CRP_BRIDGE_RUSTC_ENV,
    deps = [
        ":lib",
        "@crates//:anyhow",
        "@crates//:clap",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "unit_tests",
    crate = ":lib",
    deps = [
        "@crates//:pretty_assertions",
        "@crates//:tempfile",
    ],
)
