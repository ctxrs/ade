+        turn_id: String,
+        status: CrpTurnStatus,
+        #[serde(skip_serializing_if = "Option::is_none")]
+        error: Option<CrpTurnError>,
+    },
+    #[serde(rename = "tool.started")]
+    ToolStarted {
+        session_id: String,
+        turn_id: String,
+        tool_call_id: String,
+        tool_name: String,
