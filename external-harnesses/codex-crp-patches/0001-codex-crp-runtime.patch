+        #[serde(skip_serializing_if = "Option::is_none")]
+        input_preview: Option<Value>,
+    },
+    #[serde(rename = "tool.request")]
+    ToolRequest {
+        session_id: String,
+        turn_id: String,
+        tool_call_id: String,
+        tool_name: String,
+        input: Option<Value>,
+    },
+    #[serde(rename = "tool.output.delta")]
+    ToolOutputDelta {
