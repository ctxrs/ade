<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE plist PUBLIC '-//Apple//DTD PLIST 1.0//EN' 'http://www.apple.com/DTDs/PropertyList-1.0.dtd'>
<plist version='1.0'>
<dict>
  <key>Label</key>
  <string>__LABEL__</string>
  <key>ProgramArguments</key>
  <array>
    <string>__MAC_ROOT__/bin/cleanup_agents.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>MAC_ROOT</key>
    <string>__MAC_ROOT__</string>
    <key>PORT_LOCK_DIR</key>
    <string>__MAC_ROOT__/ports</string>
    <key>AGENTS_DIR</key>
    <string>__MAC_ROOT__/agents</string>
    <key>TTL_SECONDS</key>
    <string>__TTL_SECONDS__</string>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StartInterval</key>
  <integer>1800</integer>
  <key>StandardOutPath</key>
  <string>__MAC_ROOT__/logs/cleanup.log</string>
  <key>StandardErrorPath</key>
  <string>__MAC_ROOT__/logs/cleanup.log</string>
  <key>RunAtLoad</key>
  <true/>
</dict>
</plist>
